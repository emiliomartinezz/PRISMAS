# Credenciales del broker MQTT de PRISMAS.
#
# 1) Copia este fichero:      cp mqtt.env.example mqtt.env
# 2) Rellena mqtt.env con tus datos (este .example se queda SIN datos).
# 3) mqtt.env esta en .gitignore: NUNCA lo subas al repositorio.
# 4) Cargalo en cada terminal antes de lanzar gemelo, plugin u OMNeT++:
#        source mqtt.env
#
# Si PRISMAS_MQTT_USER esta vacio, los clientes se conectan sin credenciales
# (util para el broker local).

export PRISMAS_MQTT_USER="PON_AQUI_TU_USUARIO"
export PRISMAS_MQTT_PASS="PON_AQUI_TU_CONTRASENA"
