<config>
    <!-- Igual que el ejemplo simulations/NR/cars de Simu5G.
         La interfaz celular de gNodeBs y coches en 10.0.0.0/8: los coches se
         crean en tiempo de ejecucion y HostAutoConfigurator les da una
         direccion 10.x.x.x (addressBase por defecto 10.0.0.0/8). -->
    <interface hosts="gNodeB*" names="cellular" address="10.x.x.x" netmask="255.0.0.0"/>
    <interface hosts="car*" names="cellular" address="10.x.x.x" netmask="255.0.0.0"/>

    <!-- El resto (backhaul, X2, server...) en 192.168.x.x para no chocar
         con las direcciones de los coches -->
    <interface hosts="*" address="192.168.x.x" netmask="255.255.255.0"/>
</config>
